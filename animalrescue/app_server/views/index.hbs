{{!--
  Home Page
  Introduces the rescue animal system and displays one featured reserved animal.
--}}

{{!-- Page Header --}}
<section class="page-heading">
  <h1 class="eyebrow">HOME PAGE</h1>
  <h2>Animal Rescue System</h2>
  <p>Supporting trained rescue animals and the teams who depend on them.</p>
</section>

{{!-- Featured Content --}}
<section class="home-feature">
  <div class="home-gallery">
    <img src="/images/SearchAndRescueDog.jfif" alt="Search and rescue dog working outdoors">
    <img src="/images/SearchAndRescueDog2.jfif" alt="Search and rescue dog with handler">
  </div>

  {{!-- Featured animal data comes from the main controller. --}}
  <div class="featured-animal">
    <h2>Featured Animal</h2>
    {{> animal_cards animals=featuredAnimals}}
  </div>
</section>
